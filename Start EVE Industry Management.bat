@echo off
rem Starts EVE Industry Management at http://localhost:8642/ so EVE logins complete by themselves.
rem It also reads web pages for the tool (supplier stock lists), which a browser page cannot do by itself.
rem Keep this file in the same folder as "EVE Industry Management.html". Close this window to stop.
cd /d "%~dp0"
title EVE Industry Management
powershell -NoProfile -ExecutionPolicy Bypass -Command "$f = Join-Path (Get-Location) 'EVE Industry Management.html'; if (-not (Test-Path $f)) { Write-Host 'EVE Industry Management.html was not found next to this launcher.'; Read-Host 'Press Enter to close'; exit 1 }; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $l = New-Object Net.HttpListener; $l.Prefixes.Add('http://localhost:8642/'); try { $l.Start() } catch { Write-Host 'Could not start on port 8642. Is the tool already running in another window?'; Write-Host $_; Read-Host 'Press Enter to close'; exit 1 }; Start-Process 'http://localhost:8642/'; Write-Host 'EVE Industry Management is running at http://localhost:8642/'; Write-Host 'Keep this window open while you use it. Close it to stop.'; while ($l.IsListening) { try { $c = $l.GetContext(); $r = $c.Response; $r.Headers.Add('Cache-Control', 'no-store'); if ($c.Request.Url.AbsolutePath -eq '/proxy') { $t = $c.Request.QueryString['url']; if ($t -notmatch '^https?://') { $r.StatusCode = 400; $b = [Text.Encoding]::UTF8.GetBytes('Only web links can be read') } else { try { $w = New-Object Net.WebClient; $w.Headers.Add('User-Agent', 'Mozilla/5.0 (EVE Industry Management, local tool)'); $b = $w.DownloadData($t) } catch { $r.StatusCode = 502; $b = [Text.Encoding]::UTF8.GetBytes([string]$_) } }; $r.ContentType = 'application/octet-stream' } else { $b = [IO.File]::ReadAllBytes($f); $r.ContentType = 'text/html; charset=utf-8' }; $r.ContentLength64 = $b.Length; $r.OutputStream.Write($b, 0, $b.Length); $r.Close() } catch { } }"
